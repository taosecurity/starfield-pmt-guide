<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Runs on a newer .NET too (for example a machine with only the .NET 10 SDK). -->
    <RollForward>Major</RollForward>
    <!-- Lock transitive dependency versions so every restore gets the same packages. Commit packages.lock.json. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact pins: BuildKit 0.5.0 is tested with Mutagen.Bethesda.Starfield 0.54.4. -->
    <PackageReference Include="Taosecurity.Starfield.BuildKit" Version="[0.5.0]" />
    <PackageReference Include="Mutagen.Bethesda.Starfield" Version="[0.54.4]" />
  </ItemGroup>

</Project>
